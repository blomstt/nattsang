<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks for src/Core and src/Playback, the parts that run without GTK:
       a plain console app, no test framework.
       Run: dotnet run, with project tests/CoreTests (exits 1 if any check fails). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Nattsang</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/Core/**/*.cs" LinkBase="src/Core" />
    <Compile Include="../../src/Playback/**/*.cs" LinkBase="src/Playback" />
  </ItemGroup>

</Project>
