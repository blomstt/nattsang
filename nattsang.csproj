<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>nattsang</AssemblyName>
    <RootNamespace>Nattsang</RootNamespace>
    <Version>0.1.0</Version>

    <!-- One small native binary, nothing it doesn't use. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <!-- The tests are their own project (tests/CoreTests). -->
  <ItemGroup>
    <Compile Remove="tests/**;helper/**" />
    <None Remove="tests/**;helper/**" />
  </ItemGroup>

  <!-- The player helper, once built (see the README), goes
       beside the binary; without it the window plays the sample album. -->
  <ItemGroup Condition="Exists('helper/target/release/nattsang-helper')">
    <None Include="helper/target/release/nattsang-helper" Link="nattsang-helper" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
